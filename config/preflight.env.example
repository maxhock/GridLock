# Copy this file to config/preflight.env and adjust values for your machine.

# CST Postgres helper service
CST_POSTGRES_HOST=localhost
CST_POSTGRES_PORT=5432
CST_POSTGRES_DB=copper
CST_POSTGRES_USER=worker
CST_POSTGRES_PASSWORD=worker
CST_POSTGRES_ADMIN_EMAIL=admin@gridlock.local
CST_POSTGRES_ADMIN_PASSWORD=admin

# CST Mongo helper service
CST_MONGO_HOST=mongodb://localhost
CST_MONGO_PORT=27017
CST_MONGO_DB=copper
CST_MONGO_ROOT_USERNAME=admin
CST_MONGO_ROOT_PASSWORD=SuperSecret

# Runtime host injected into the generated experiment compose file
CST_BROKER_HOST=host.docker.internal

# External InfDB source connection
INFDB_DB=infdb
INFDB_USER=your-remote-infdb-user
INFDB_PASSWORD=change-me
INFDB_HOST=10.162.28.40
INFDB_PORT=54329
INFDB_EPSG=25832

# Local InfDB demo override (from inside the Docker preflight container)
# INFDB_DB=infdb
# INFDB_USER=your-local-infdb-user
# INFDB_PASSWORD=change-me
# INFDB_HOST=host.docker.internal
# INFDB_PORT=54328