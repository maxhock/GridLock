# Copy this file to config/preflight.env and adjust values for your machine.

FORCE_REBUILD=0

CST_HOST=localhost
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
MONGO_HOST=mongodb://localhost
MONGO_PORT=27017

RUNTIME_CST_HOST=host.docker.internal
RUNTIME_POSTGRES_HOST=host.docker.internal
RUNTIME_POSTGRES_PORT=5432
RUNTIME_MONGO_HOST=mongodb://host.docker.internal
RUNTIME_MONGO_PORT=27017

PREFLIGHT_MONGO_HOST=mongodb://host.docker.internal
PREFLIGHT_MONGO_PORT=27017

SERVICES_POSTGRES_DB=infdb
SERVICES_POSTGRES_USER=your-remote-infdb-user
SERVICES_POSTGRES_PASSWORD=change-me
SERVICES_POSTGRES_HOST=10.162.28.40
SERVICES_POSTGRES_EXPOSED_PORT=54329
SERVICES_POSTGRES_EPSG=25832

# Local InfDB demo override (from inside the Docker preflight container)
