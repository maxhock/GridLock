{
    "name": "template",
    "loglevel": "warning",
    "coreType": "zmq",
    "period": 3600,
    "offset": 0,
    "max_cosim_duration": 82800,
    "broker": "broker",
    "uninterruptible": false,
    "terminate_on_error": true,
    "wait_for_current_time_update": true,
    "publications": [
        {
            "key": "example/output",
            "type": "double",
            "unit": "W",
            "global": false,
            "info": "Example publication - power output in watts"
        }
    ],
    "subscriptions": [
        {
            "key": "example/input",
            "type": "double",
            "unit": "W",
            "info": "Example subscription - power input in watts"
        }
    ]
}